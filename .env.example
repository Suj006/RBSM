DATABASE_URL="file:./dev.db"

# Public URL of the portal, used in e-mails (login link).
APP_URL="http://localhost:3000"

# Outgoing mail. Leave SMTP_HOST empty in development: e-mails are then only
# recorded in the Admin > E-mail Outbox (and printed to the server console).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="TRADEX 2.0 RBSM <no-reply@example.com>"
