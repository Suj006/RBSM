// TRADEX 2.0 — Reverse Buyer Seller Meet (RBSM) portal
// Phase 1: buyer sign-up, profile, FIEO verification, DIC approval.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  BUYER
  FIEO
  DIC // Directorate of Industries & Commerce (state level)
  ADMIN
  DISTRICT // District Industries Centre — one login per district
  SELLER // MSME seller, login allotted on Directorate approval
  NODAL // Directorate nodal officer for a group of buyers on the event days
}

// Buyer registration stage. Sector requirements are approved one by one
// (see ItemStatus); the buyer becomes APPROVED with their first approved sector.
enum BuyerStatus {
  SIGNED_UP // account created, basic details not yet submitted
  BASIC_SUBMITTED // basic details waiting for FIEO approval
  BASIC_RETURNED // FIEO sent basic details back with a comment
  BASIC_APPROVED // FIEO approved; buyer adds sector requirements
  APPROVED // at least one sector approved by DIC — on the RBSM buyer list
}

// Approval state of one sector requirement.
enum ItemStatus {
  DRAFT // being prepared (new, or an approved sector being modified)
  SUBMITTED // waiting for FIEO recommendation
  FIEO_RETURNED // FIEO returned it to the buyer with a comment
  FIEO_RECOMMENDED // waiting for Directorate (DIC) approval
  DIC_RETURNED // DIC returned it to FIEO with a comment for re-verification
  APPROVED // approved by DIC
}

enum ReviewAction {
  SIGNED_UP
  BASIC_SUBMITTED
  BASIC_APPROVED
  BASIC_RETURNED
  REQ_SUBMITTED
  REQ_RETURNED
  FIEO_RECOMMENDED
  DIC_RETURNED
  DIC_APPROVED
  REQ_WITHDRAWN // buyer removed a sector
  REQ_MODIFIED // buyer reopened an approved sector for changes
}

enum DocumentKind {
  PROFILE
  CREDENTIALS
}

enum EmailStatus {
  SENT
  LOGGED // SMTP not configured — recorded in the outbox only
  FAILED
}

model User {
  id                 String    @id @default(cuid())
  username           String    @unique
  passwordHash       String
  role               Role
  displayName        String
  district           String? // DISTRICT users: the district they manage
  mustChangePassword Boolean   @default(false)
  isActive           Boolean   @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions     Session[]
  buyer        Buyer?
  seller       Seller?      @relation("SellerLogin")
  reviewLogs   ReviewLog[]
  sellersAdded Seller[]     @relation("SellerCreatedBy")
  sellerLogs   SellerLog[]
  targetsSet   Target[]     @relation("TargetUpdatedBy")
  matchEvents  MatchEvent[]

  messages        Message[]               @relation("MessageAuthor")
  hiddenMessages  Message[]               @relation("MessageHiddenBy")
  announcements   Announcement[]          @relation("AnnouncementAuthor")
  announcementsIn AnnouncementRecipient[]
  convReads       ConversationRead[]

  nodalOfficer     NodalOfficer?
  meetingsMarked   ScheduledMeeting[]   @relation("MeetingMarkedBy")
  meetingsMoved    ScheduledMeeting[]   @relation("MeetingMovedBy")
  buyersAdded      Buyer[]              @relation("BuyersAdded")
  mousVerified     Mou[]                @relation("MouNodalVerified")
  mousApproved     Mou[]                @relation("MouFieoApproved")
  mousReturned     Mou[]                @relation("MouReturned")
  buyerDaysMarked  BuyerDayAttendance[]
}

model Session {
  id        String   @id // random token stored in the cookie (hashed)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Named running counters, e.g. "buyer" (Tradex2027-001 / RBSM-B-001) and
// "approved-2026" (RBSM-Buyer-2026001).
model Counter {
  name  String @id
  value Int    @default(0)
}

model Buyer {
  preferredBy      SellerPreference[]
  matches          Match[]
  publishedMatches PublishedMatch[]

  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  seq   Int    @unique // 1, 2, 3…
  regNo String @unique // RBSM-B-001

  name        String // buyer / organisation name (from sign-up, editable)
  country     String
  signupEmail String @unique

  // Point of contact
  pocName        String?
  pocDesignation String?
  pocEmail       String?
  pocMobile      String?

  status BuyerStatus @default(SIGNED_UP)

  source      BuyerSource @default(SELF)
  createdById String?
  createdBy   User?       @relation("BuyersAdded", fields: [createdById], references: [id], onDelete: SetNull)

  basicSubmittedAt DateTime?
  basicApprovedAt  DateTime?
  reqSubmittedAt   DateTime?
  recommendedAt    DateTime?
  approvedAt       DateTime?

  approvedSeq Int?    @unique
  approvedNo  String? @unique // RBSM-Buyer-2026001

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents   Document[]
  requirement Requirement?

  conversations Conversation[]
  announcements Announcement[]

  // Event day: the buyer's pavilion (sellers come to it) and the Directorate nodal officer looking after the buyer.
  pavilionNo       Int?                 @unique
  nodalOfficerId   String?
  nodalOfficer     NodalOfficer?        @relation(fields: [nodalOfficerId], references: [id], onDelete: SetNull)
  meetings         Meeting[]
  scheduled        ScheduledMeeting[]
  dayAttendance    BuyerDayAttendance[]
  mous             Mou[]
  reviewLogs  ReviewLog[]

  @@index([status])
  @@index([country])
}

model Document {
  id           String       @id @default(cuid())
  buyerId      String
  buyer        Buyer        @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  kind         DocumentKind
  originalName String
  storedName   String
  mimeType     String
  size         Int
  uploadedAt   DateTime     @default(now())

  @@unique([buyerId, kind])
}

model Sector {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requirementItems RequirementItem[]
  sellerProducts   SellerProduct[]
  mous             Mou[]
}

model Certification {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Requirement {
  id      String @id @default(cuid())
  buyerId String @unique
  buyer   Buyer  @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  organisationType     String? // Importer, Distributor, Retail chain…
  procurementInterests String? // free text overview of what they want to source
  annualSourcingValue  String? // bracket, e.g. "USD 1–5 million"
  sourcingTimeline     String? // Immediate / 3–6 months / …
  preferredEngagement  String? // Long-term supply, JV, one-time order…
  approvedProfile      String? // JSON copy of the sourcing profile at the last sector approval

  items RequirementItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RequirementItem {
  id             String      @id @default(cuid())
  requirementId  String
  requirement    Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  sectorId       String
  sector         Sector      @relation(fields: [sectorId], references: [id])
  products       String // comma / newline separated product names
  specifications String?
  certifications String      @default("[]") // JSON array of certification names
  quantity       String? // indicative volume
  sortOrder      Int         @default(0)

  status           ItemStatus @default(DRAFT)
  submittedAt      DateTime?
  recommendedAt    DateTime?
  approvedAt       DateTime?
  everApproved     Boolean    @default(false) // was approved at least once (modified since)
  // Copies of the content (JSON) so reviewers can see what changed on resubmission.
  approvedSnapshot String? // content as last approved by the Directorate
  returnedSnapshot String? // content as returned by FIEO for correction
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @default(now()) @updatedAt

  reviewLogs ReviewLog[]

  @@unique([requirementId, sectorId])
  @@index([status])
}

model ReviewLog {
  id         String           @id @default(cuid())
  buyerId    String
  buyer      Buyer            @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?            @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorRole  Role
  action     ReviewAction
  // Set for sector-level actions; sectorName keeps the label if the row is removed.
  itemId     String?
  item       RequirementItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  sectorName String?
  comment    String?
  createdAt  DateTime         @default(now())

  @@index([buyerId, createdAt])
}

model EmailLog {
  id        String      @id @default(cuid())
  to        String
  subject   String
  body      String
  status    EmailStatus
  error     String?
  createdAt DateTime    @default(now())
}

// ---------------------------------------------------------------- sellers (MSMEs)

enum SellerStatus {
  WITH_DISTRICT // entered by the district office or self-registered; awaiting district recommendation
  WITH_SELLER // returned by the district to the applicant, who corrects it with the temporary login
  RECOMMENDED // recommended by the district to the Directorate
  RETURNED // Directorate returned it to the district with a comment
  APPROVED // approved by the Directorate — login allotted, visible to FIEO
  REJECTED // rejected by the district or the Directorate
}

// How a buyer came in: own sign-up, or added by FIEO one at a time or by bulk upload (temporary login until approval).
enum BuyerSource {
  SELF
  FIEO
  BULK
}

enum SellerSource {
  DISTRICT // entered individually by a district office
  BULK // bulk Excel upload by a district office
  SELF // self-registration on the portal
}

enum LocalBodyType {
  PANCHAYAT
  MUNICIPALITY
  CORPORATION
}

enum SellerAction {
  REGISTERED
  UPDATED
  SENT_TO_SELLER // district returned the application to the applicant for correction
  RESUBMITTED // applicant corrected and resubmitted it
  RECOMMENDED
  RETURNED
  APPROVED
  REJECTED
  PROFILE_UPDATED // approved seller completed / updated the profile
}

model Seller {
  id    String @id @default(cuid())
  seq   Int    @unique
  regNo String @unique // RBSM-S-001

  name             String
  district         String
  taluk            String
  localBodyType    LocalBodyType
  localBodyName    String
  udyamNo          String        @unique // UDYAM-KL-00-0000000
  exportExperience Boolean
  // Export history (reference only — not used in matchmaking): countries already exported to and the products.
  exportCountries  String        @default("[]") // JSON array of country names
  exportedProducts String?
  iecNo            String? // Importer-Exporter Code (10 characters); required when the seller has export experience
  certifications   String        @default("[]") // JSON array: quality / product certifications held

  // Profile completed by the seller after approval (option values in src/lib/config.ts).
  promoterGender     String?
  promoterDob        DateTime?
  socialCategory     String?
  speciallyAbled     Boolean?
  block              String?
  constitution       String?
  unitCategory       String?
  unitType           String?
  profileCompletedAt DateTime?

  contactName     String
  contactMobile   String // 10-digit Indian mobile number
  contactWhatsapp String
  contactEmail    String

  source      SellerSource
  createdById String?
  createdBy   User?        @relation("SellerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  status        SellerStatus @default(WITH_DISTRICT)
  recommendedAt DateTime?
  approvedAt    DateTime?
  approvedSeq   Int?         @unique
  approvedNo    String?      @unique // RBSM-Seller-2026001

  // Login. Online applicants get it at registration (limited "application" access until
  // approved); district-entered sellers get it on approval or when returned to the applicant.
  userId String? @unique
  user   User?   @relation("SellerLogin", fields: [userId], references: [id], onDelete: SetNull)

  products SellerProduct[]
  logs     SellerLog[]

  conversations Conversation[]
  meetings      Meeting[]
  scheduled     ScheduledMeeting[]
  mous          Mou[]

  // Matchmaking: up to 5 preferred buyers, submitted once (cannot be changed afterwards).
  prefSubmittedAt  DateTime?
  preferences      SellerPreference[]
  matches          Match[]
  publishedMatches PublishedMatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([district, status])
  @@index([status])
}

// Products the seller is ready to export, per sector (same sector master as buyers,
// so buyer requirements and seller products can be matched sector by sector).
model SellerProduct {
  id        String @id @default(cuid())
  sellerId  String
  seller    Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  sectorId  String
  sector    Sector @relation(fields: [sectorId], references: [id])
  products  String
  sortOrder Int    @default(0)

  @@unique([sellerId, sectorId])
  @@index([sectorId])
}

model SellerLog {
  id        String       @id @default(cuid())
  sellerId  String
  seller    Seller       @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorRole Role? // null for public self-registration
  action    SellerAction
  comment   String?
  createdAt DateTime     @default(now())

  @@index([sellerId, createdAt])
}

// Programme targets set by the Directorate. Keys: "sellers", "buyers",
// "sellersPerBuyer" and "district:<District name>" (approved-seller target per district).
model Target {
  key         String   @id
  value       Int
  updatedById String?
  updatedBy   User?    @relation("TargetUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------- matchmaking

/**
 * Matchmaking switches and settings (buyer directory visibility, preference freeze, lock, version…).
 */
model MatchSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/**
 * A seller's preferred buyer, rank 1–5 (tentative; considered with other conditions).
 */
model SellerPreference {
  id        String   @id @default(cuid())
  sellerId  String
  seller    Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  buyerId   String
  buyer     Buyer    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  rank      Int
  createdAt DateTime @default(now())

  @@unique([sellerId, rank])
  @@unique([sellerId, buyerId])
  @@index([buyerId])
}

enum MatchSource {
  PREFERENCE // suggested because the seller preferred this buyer
  SYSTEM // suggested by the portal on sector / product fit
  MANUAL // added by the Directorate
}

/**
 * Working (draft) buyer–seller mapping, edited by the Directorate. Removed pairs are kept so suggestions do not bring them back.
 */
model Match {
  id        String      @id @default(cuid())
  buyerId   String
  buyer     Buyer       @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId  String
  seller    Seller      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  source    MatchSource
  score     Float       @default(0)
  removed   Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([buyerId, sellerId])
  @@index([sellerId])
}

/**
 * The mapping as last published — what buyers, sellers, FIEO and districts see.
 */
model PublishedMatch {
  id       String      @id @default(cuid())
  version  Int
  buyerId  String
  buyer    Buyer       @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId String
  seller   Seller      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  source   MatchSource
  score    Float       @default(0)
  slot     Int

  @@unique([buyerId, sellerId])
  @@index([sellerId])
}

/**
 * Audit trail of matchmaking actions.
 */
model MatchEvent {
  id        String   @id @default(cuid())
  action    String
  detail    String?
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------- communications

enum ConversationKind {
  BUYER_SELLER // a matched buyer and seller (open once the Directorate enables interaction after publishing)
  DESK_BUYER // a buyer and the programme team (Directorate / FIEO)
  DESK_SELLER // a seller and the programme team (Directorate / FIEO)
}

// One conversation per buyer–seller pair, and one programme-desk conversation per buyer and per seller.
// Seen by its participants, the Directorate and FIEO (Admin: read only) — never by other buyers or sellers.
model Conversation {
  id            String           @id @default(cuid())
  kind          ConversationKind
  buyerId       String?
  buyer         Buyer?           @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId      String?
  seller        Seller?          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  closed        Boolean          @default(false) // closed by the Directorate / FIEO: participants cannot post
  lastMessageAt DateTime         @default(now())
  createdAt     DateTime         @default(now())

  messages Message[]
  reads    ConversationRead[]

  @@index([kind, buyerId, sellerId])
  @@index([lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String
  author         User         @relation("MessageAuthor", fields: [authorId], references: [id])
  authorRole     Role
  body           String
  hiddenAt       DateTime? // withdrawn by the Directorate / FIEO (kept for the record, shown as withdrawn)
  hiddenById     String?
  hiddenBy       User?        @relation("MessageHiddenBy", fields: [hiddenById], references: [id])
  createdAt      DateTime     @default(now())

  attachments Attachment[]

  @@index([conversationId, createdAt])
}

model ConversationRead {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime

  @@id([conversationId, userId])
}

// A common communication: from the Directorate / FIEO to a group or one participant, or from a buyer to all
// its matched sellers. Recipients are fixed when it is sent; only they (and the Directorate / FIEO / Admin) see it.
model Announcement {
  id            String   @id @default(cuid())
  authorId      String
  author        User     @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  authorRole    Role
  buyerId       String? // set when a buyer writes to its matched sellers
  buyer         Buyer?   @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  audience      String // e.g. ALL_BUYERS, APPROVED_SELLERS, BUYER_MATCHED_SELLERS
  audienceLabel String // plain-language description of who received it
  subject       String
  body          String
  createdAt     DateTime @default(now())

  recipients  AnnouncementRecipient[]
  attachments Attachment[]

  @@index([createdAt])
}

model AnnouncementRecipient {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime?

  @@unique([announcementId, userId])
  @@index([userId, readAt])
}

// A shared document: the sender names it (e.g. "Product catalogue 2026").
model Attachment {
  id             String        @id @default(cuid())
  messageId      String?
  message        Message?      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  announcementId String?
  announcement   Announcement? @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  name           String
  originalName   String
  storedName     String
  mimeType       String
  size           Int
  createdAt      DateTime      @default(now())
}

// ---------------------------------------------------------------- event days and meeting schedule

// One row per event day (dates and hours set by the Directorate). Times are IST "HH:MM".
model EventDay {
  id        String @id @default(cuid())
  date      String @unique // YYYY-MM-DD
  startTime String // first meeting may start at
  endTime   String // last meeting must end by
  breaks    String @default("[]") // JSON [{ "label": "Lunch", "start": "13:00", "end": "14:00" }]
}

model NodalOfficer {
  id          String  @id @default(cuid())
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  designation String?
  mobile      String
  email       String
  buyers      Buyer[]
  createdAt   DateTime @default(now())
}

// Working (draft) schedule — seen only by the Directorate / FIEO / Admin until it is published.
model Meeting {
  id       String   @id @default(cuid())
  buyerId  String
  buyer    Buyer    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId String
  seller   Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  day      String // YYYY-MM-DD
  startAt  DateTime
  endAt    DateTime
  manual   Boolean  @default(false) // placed or moved by the Directorate (kept when the draft is regenerated)
  updatedAt DateTime @updatedAt

  @@unique([buyerId, sellerId])
  @@index([day, startAt])
}

enum MeetingStatus {
  SCHEDULED
  SELLER_PRESENT // ticket verified by the nodal officer
  SELLER_ABSENT
  BUYER_ABSENT
  COMPLETED
  CANCELLED
}

// Published schedule: what buyers, sellers, nodal officers and FIEO see. Each meeting has a ticket.
model ScheduledMeeting {
  id         String        @id @default(cuid())
  ticketNo   String        @unique
  buyerId    String
  buyer      Buyer         @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId   String
  seller     Seller        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  day        String
  startAt    DateTime
  endAt      DateTime
  pavilionNo Int?
  status     MeetingStatus @default(SCHEDULED)
  markedAt   DateTime?
  markedById String?
  markedBy   User?         @relation("MeetingMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)
  note       String?
  version    Int
  // Event-day change by a nodal officer / the Directorate: original start, when and by whom,
  // and the absent seller's meeting whose slot this meeting took.
  movedFrom   DateTime?
  movedAt     DateTime?
  movedById   String?
  movedBy     User?         @relation("MeetingMovedBy", fields: [movedById], references: [id], onDelete: SetNull)
  replacesId  String?
  mous        Mou[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([buyerId, sellerId])
  @@index([day, startAt])
}

model BuyerDayAttendance {
  buyerId    String
  buyer      Buyer    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  day        String
  present    Boolean
  markedById String?
  markedBy   User?    @relation(fields: [markedById], references: [id], onDelete: SetNull)
  markedAt   DateTime @default(now())

  @@id([buyerId, day])
}

// ---------------------------------------------------------------- MoUs (intention for placing orders)

enum MouStatus {
  SUBMITTED // filled by the buyer; with the nodal officer and FIEO
  RETURNED // returned to the buyer for correction
  APPROVED // verified by the nodal officer and approved by FIEO — visible to the seller
  WITHDRAWN // withdrawn by the buyer
}

/// A memorandum of understanding signed after a successful buyer–seller meeting.
/// Number: RBSM-MOU-2026-B007-S012 (buyer and seller approved numbers), "-2" for a second MoU of the same pair.
model Mou {
  id       String    @id @default(cuid())
  seq      Int       @unique // overall serial, 1, 2, 3…
  mouNo    String    @unique
  buyerId  String
  buyer    Buyer     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId String
  seller   Seller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  sectorId String?
  sector   Sector?   @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  meetingId String?
  meeting   ScheduledMeeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  goods      String // description of goods
  currency   String // "USD" | "INR"
  amount     Float? // approximate value; null = to be determined
  orderMonth String // approximate month of placing the order, "2026-05"

  status      MouStatus @default(SUBMITTED)
  submittedAt DateTime  @default(now())
  nodalVerifiedAt   DateTime?
  nodalVerifiedById String?
  nodalVerifiedBy   User?     @relation("MouNodalVerified", fields: [nodalVerifiedById], references: [id], onDelete: SetNull)
  fieoApprovedAt    DateTime?
  fieoApprovedById  String?
  fieoApprovedBy    User?     @relation("MouFieoApproved", fields: [fieoApprovedById], references: [id], onDelete: SetNull)
  approvedAt        DateTime?
  returnComment     String?
  returnedAt        DateTime?
  returnedById      String?
  returnedBy        User?     @relation("MouReturned", fields: [returnedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([buyerId])
  @@index([sellerId])
}
